ENVIRONMENT=dev
LOG_LEVEL=INFO
LOG_FORMAT=pretty

OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-5.4-mini
OPENAI_ORCHESTRATOR_MODEL=gpt-5.5

SERPAPI_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_ROUTES_API_KEY=
OPENWEATHER_API_KEY=
BRAVE_API_KEY=

TRAVEL_A2A_URL=http://127.0.0.1:8002
LOCAL_A2A_URL=http://127.0.0.1:8001
TRANSIT_A2A_URL=http://127.0.0.1:8004

WEB_PLAN_TIMEOUT_SECONDS=360
WEB_MAX_TURNS=18
WEB_MAX_CONCURRENT_PLANS=2

# Agent economy (ledger service on :8005). One shared-secret key per agent;
# the ledger needs all of them, each agent only its own.
LEDGER_URL=http://127.0.0.1:8005
LEDGER_DB_PATH=ledger.db
ECONOMY_ADMIN_KEY=
AGENT_KEY_CONCIERGE=
AGENT_KEY_TRAVEL=
AGENT_KEY_LOCAL=
AGENT_KEY_TRANSIT=
ECONOMY_DAILY_ALLOWANCE_MC=50000
ECONOMY_DAILY_CAP_MC=50000
ECONOMY_HOLD_SECONDS=180
